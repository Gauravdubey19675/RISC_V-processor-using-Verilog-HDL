`timescale 1ns/1ps


 module testbench;
  reg clk;
  reg reset;
  wire misalligned_access;
  wire access_bound;
  
  always 
    begin
      clk = ~clk;#5;
    end
  
  topmost DUT(access_bound ,misalligned_access , clk , reset);
  
  initial
    begin
      
      $dumpfile("testbench.vcd");
      $dumpvars(0,testbench);
      
      $monitor($time , "access_bound = %b , misalligned_access = %b , clk = %b , reset = %b", access_bound , misalligned_access , clk , reset );
      reset = 1'b1;
      clk=1'b0;#4;
      reset = 1'b0;
      #350;
      
      $finish;
      
    end
endmodule
      

