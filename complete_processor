is_sb , is_sh , is_sw ,
is_beq , is_bne , is_blt , is_bge , is_bltu , is_bgeu , is_jal , is_jalr , is_lui , is_auipc , instruction, PC_curr , result ,rd_out_2 , rd_out_1 ,data_out  );
