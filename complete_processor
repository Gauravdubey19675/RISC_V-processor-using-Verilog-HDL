temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_xor)
begin
ALU_control = 6'b000101;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_sll)
begin
ALU_control = 6'b000110;
temp_2={{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_srl)
begin
ALU_control = 6'b000111;
temp_2 = {{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1= result;
end

else if (is_sra)
begin
ALU_control = 6'b001000;
temp_2 = {{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1 = result;
end


else if (is_sltu)
begin
ALU_control = 6'b001001;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if (is_slt)
begin
ALU_control = 6'b001010;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

if (is_addi)
begin
ALU_control = 6'b001011;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}}, immediate} ;  /// imm to add is stored in temp_2;
temp_1 = result;
end


