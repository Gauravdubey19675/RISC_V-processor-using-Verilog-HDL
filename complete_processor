//register_type
assign is_add  = ~reset && (instruction[6:0] == 7'b0110011) && (instruction[14:12] == 3'b000) && (instruction[31:25] == 7'b0000000);
assign is_sub  = ~reset && (instruction[6:0]   == 7'b0110011 ) && (instruction[14:12] == 3'b000) && (instruction[31:25] == 7'b0100000);
assign is_and  = ~reset && (instruction[6:0]  == 7'b0110011) && (instruction[14:12] == 3'b111) && (instruction[31:25] == 7'b0000000);
assign is_or = ~reset && (instruction[6:0]   == 7'b0110011) && (instruction[14:12] == 3'b110) && (instruction[31:25] == 7'b0000000);
assign is_xor  =  ~reset && (instruction[6:0]   == 7'b0110011) && (instruction[14:12] == 3'b100) && (instruction[31:25] == 7'b0000000);
assign is_sll = ~reset && (instruction[6:0]   == 7'b0110011) && (instruction[14:12] == 3'b001) && (instruction[31:25] == 7'b0000000);
assign is_slt  = ~reset && (instruction[6:0]      == 7'b0110011) && (instruction[14:12] == 3'b010) && (instruction[31:25] == 7'b0000000);
assign is_sltu = ~reset && (instruction[6:0]   == 7'b0110011) && (instruction[14:12] == 3'b011) && (instruction[31:25] == 7'b0000000);
assign is_srl  = ~reset && (instruction[6:0]   == 7'b0110011) && (instruction[14:12] == 3'b101) &&   (instruction[31:25] == 7'b0000000);
assign is_sra  = ~reset && (instruction[6:0]   == 7'b0110011)    &&     (instruction[14:12] == 3'b101) && (instruction[31:25] == 7'b0100000);


//immediate register_type
assign is_addi  = ~reset &&  (instruction[6:0] == 7'b0010011) && (instruction[14:12] == 3'b000); 
assign is_slti  = ~reset &&(instruction[6:0] == 7'b0010011) &&  (instruction[14:12] == 3'b010); 
assign is_sltiu = ~reset &&(instruction[6:0] == 7'b0010011) &&(instruction[14:12] ==  3'b011); 
assign is_xori  =~reset &&(instruction[6:0] == 7'b0010011)&& (instruction[14:12] == 3'b100); 
assign is_ori   = ~reset&& (instruction[6:0] == 7'b0010011) &&(instruction[14:12] == 3'b110); 
assign is_andi  = ~reset && (instruction[6:0] == 7'b0010011) &&(instruction[14:12] == 3'b111); 
assign is_slli  = ~reset &&(instruction[6:0] == 7'b0010011)&& (instruction[14:12] == 3'b001) &&(instruction[31:25] == 7'b0000000);
assign is_srli  = ~reset && (instruction[6:0] == 7'b0010011) &&(instruction[14:12] == 3'b101)&& (instruction[31:25] == 7'b0000000);
assign is_srai  = ~reset && (instruction[6:0] == 7'b0010011) &&(instruction[14:12] == 3'b101)&& (instruction[31:25] == 7'b0100000);


//load_type
assign is_lb  = ~reset &&(instruction[6:0] == 7'b0000011) && (instruction[14:12] == 3'b000);
assign is_lh  = ~reset && (instruction[6:0]  == 7'b0000011) && (instruction[14:12] ==  3'b001);
assign is_lw  = ~reset &&(instruction[6:0]   == 7'b0000011) &&(instruction[14:12] == 3'b010);
assign is_lbu = ~reset &&(instruction[6:0]   == 7'b0000011)&& (instruction[14:12] == 3'b100);
assign is_lhu = ~reset&&(instruction[6:0] == 7'b0000011)&&(instruction[14:12] == 3'b101);


//jump_type
assign is_jal  = ~reset &&(instruction[6:0]==7'b1101111);                            
assign is_jalr = ~reset &&(instruction[6:0]== 7'b1100111) &&(instruction[14:12] ==3'b000);


//store_type
assign is_sb = ~reset&& (instruction[6:0]== 7'b0100011) &&(instruction[14:12] ==3'b000); 
assign is_sh = ~reset && (instruction[6:0]  == 7'b0100011) &&(instruction[14:12] == 3'b001); 
assign is_sw = ~reset && (instruction[6:0]== 7'b0100011) &&  (instruction[14:12] == 3'b010); 


//conditional branches type
assign is_beq  = ~reset &&(instruction[6:0]== 7'b1100011) &&(instruction[14:12]==3'b000); 
assign is_bne  = ~reset && (instruction[6:0] ==7'b1100011)&&(instruction[14:12]== 3'b001); 
assign is_blt  = ~reset &&(instruction[6:0] == 7'b1100011) &&(instruction[14:12] ==3'b100); 
assign is_bge  = ~reset && (instruction[6:0] == 7'b1100011)&& (instruction[14:12] == 3'b101); 
assign is_bltu = ~reset &&(instruction[6:0]== 7'b1100011)&&(instruction[14:12] == 3'b110); 
assign is_bgeu = ~reset && (instruction[6:0]== 7'b1100011)&& (instruction[14:12] ==3'b111); 


assign is_lui   = ~reset&&(instruction[6:0]== 7'b0110111);  
assign is_auipc = ~reset && (instruction[6:0]== 7'b0010111); 
endmodule




  
module ALU ( result,ALU_control,inp_A ,inp_B , neg_B);
input [31:0]inp_A;
input [31:0]inp_B;
input neg_B;
input[5:0]ALU_control;

output reg [31:0]result;

always@(*)
begin //1
result = 32'b0;
if(ALU_control == 6'b0)
begin
result = 32'b0;
end  
else if (ALU_control == 6'b000001)
begin    //2
if(!neg_B)
begin    //3
result = inp_A + inp_B;
end      //3
else if(neg_B)
begin   //4
result = inp_A + $signed(inp_B);
end     //4
end     //3

else if(ALU_control == 6'b000010)
begin   //5
result = inp_A - inp_B;
end     //5

else if (ALU_control == 6'b000011)
begin   //6
result = inp_A & inp_B ;
end    //6

else if (ALU_control == 6'b000100)
begin   //7
result =inp_A | inp_B;
end     //7

else if(ALU_control == 6'b000101)
begin   //8
result = inp_A ^ inp_B;
end    //8

else if (ALU_control == 6'b000110)
begin   //9
result = inp_A << inp_B;
end     //9

else if(ALU_control == 6'b000111)
begin   //10
result = inp_A >> inp_B;
end    //10

else if (ALU_control == 6'b001000)
begin   //11
result = inp_A >>> inp_B;
end     //11

else if (ALU_control == 6'b001010)
begin   //12
if ($signed(inp_A) > $signed(inp_B))
begin   //13
result = 32'b1;
end     //13
else 
result = 32'b0;
end     //12


else if (ALU_control == 6'b001001)
begin    //14
if (inp_A > inp_B)
begin    //15
result = 32'b1;
end     //15
else 
result = 32'b0;
end      //14

else if (ALU_control == 6'b001011)
begin   //16
result = inp_A + $signed(inp_B);
end    //16

else if (ALU_control == 6'b001100)
begin     //17
if ($signed(inp_A) < $signed(inp_B))
begin     //18
result = 32'b1;
end       //18
else
result = 32'b0;
end      //17

else if(ALU_control == 6'b001101)
begin    //19
if (inp_A  < inp_B)
begin    //20
result = 32'b1;
end      //20
else
result = 32'b0;
end      //19

else if (ALU_control == 6'b001110)
begin    //21
result = inp_A & inp_B;
end      //21

else if (ALU_control == 6'b001111)
begin     //22
result = inp_A | inp_B;
end      //22

else if (ALU_control == 6'b010000 )
begin     //23
result = inp_A << inp_B;
end      //23

else if (ALU_control == 6'b010001 )
begin     //24
result = inp_A >> inp_B;
end       //24

else if (ALU_control == 6'b010010)
begin    //25
result = inp_A >>> inp_B;
end      //25
end   //2

endmodule

module main_control(neg_B , temp_0 ,temp_2 ,processed_data , PC_done  ,overall_address ,wr_enable_data , wr_enable_register ,misalligned_access ,ALU_control , register_1 , register_2 , destination_register ,is_add, is_sub, is_and, is_or, is_xor, is_sll, is_slt, is_sltu, is_srl, is_sra,
