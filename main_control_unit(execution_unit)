module main_control(neg_B , temp_0 ,temp_2 ,processed_data , PC_done  ,overall_address ,wr_enable_data , wr_enable_register ,misalligned_access ,ALU_control , register_1 , register_2 , destination_register ,is_add, is_sub, is_and, is_or, is_xor, is_sll, is_slt, is_sltu, is_srl, is_sra,
is_addi, is_andi, is_ori, is_xori, is_slli, is_srli, is_srai, is_slti, is_sltiu,
is_lb , is_lh , is_lw , is_lbu , is_lhu ,
is_sb , is_sh , is_sw ,
is_beq , is_bne , is_blt , is_bge , is_bltu , is_bgeu , is_jal , is_jalr , is_lui , is_auipc , instruction, PC_curr , result ,rd_out_2 , rd_out_1 ,data_out  );
input is_add ;
input is_sub ; 
input is_and ;
input  is_or;
input  is_xor;
input  is_sll ;
input  is_slt ;
input  is_sltu ;
input is_srl ;
input  is_sra;
input is_addi ;
input is_andi ;
input  is_ori ;
input is_xori ;
input is_slli ;
input is_srli ;
input  is_srai ;
input is_slti ;
input is_sltiu ;
input is_lb ;
input is_lh ;
input is_lw ;
input is_lbu ;
input is_lhu ;
input is_sb ;
input is_sh ;
input is_sw ;
input is_beq ;
input is_bne ;
input is_blt ;
input is_bge ;
input is_bltu ;
input is_bgeu ;
input is_jal ;
input is_jalr ;
input is_lui;
input is_auipc;
input [31:0]instruction ;
input [31:0]PC_curr ;
input [31:0]rd_out_1;
input [31:0]rd_out_2;
input[31:0]result;
input [31:0]data_out;
output neg_B;
output [31:0]processed_data;
output [31:0]PC_done;
output [31:0]overall_address;
output misalligned_access;
output wr_enable_register;
output wr_enable_data;
output reg [4:0]register_1;
output reg [4:0]register_2;
output reg [4:0]destination_register;
output reg [5:0]ALU_control;


reg[11:0]immediate;
reg [31:0]complete_address;
reg [19:0]immediate_jump;
reg [11:0]raw_immediate;
reg [19:0]raw_immediate_load_upper;
reg [11:0]offset_immediate;
reg [7:0]byte_0;
reg [7:0]byte_1;
reg [7:0]byte_2;
reg [7:0]byte_3;
reg[31:0]PC_final;
reg [31:0]temp_1 ; 
output reg [31:0]temp_2;  
output reg [31:0]temp_0;

always@(*)
begin
PC_final = PC_curr + 4;
complete_address = 32'b0;
temp_1 = 32'b0;
temp_2 = 32'b0;
temp_0 = 32'b0;
ALU_control = 6'b0;
immediate = instruction[31:20];
offset_immediate = {instruction[31:25] , instruction[11:7]};
immediate_jump = {instruction[31] , instruction[19:12] , instruction[20] , instruction[30:21]};
raw_immediate = {instruction[31] , instruction[7] , instruction[30:25] , instruction[11:8]};
raw_immediate_load_upper = instruction[31:12];
register_1 = instruction[19:15];
register_2 = instruction [24:20];
destination_register = instruction[11:7];
byte_0 = data_out[7:0];
byte_1 = data_out[15:8];
byte_2 = data_out[23:16];
byte_3 = data_out[31:24];

if (is_add)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = rd_out_2;
temp_1 = result;
end

else if(is_sub)
begin
ALU_control = 6'b000010;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_and)
begin
ALU_control = 6'b000011;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_or)
begin
ALU_control = 6'b000100;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_xor)
begin
ALU_control = 6'b000101;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_sll)
begin
ALU_control = 6'b000110;
temp_2={{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1 = result;
end

else if(is_srl)
begin
ALU_control = 6'b000111;
temp_2 = {{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1= result;
end

else if (is_sra)
begin
ALU_control = 6'b001000;
temp_2 = {{27'b0} , rd_out_2[4:0]};
temp_0 = rd_out_1;
temp_1 = result;
end


else if (is_sltu)
begin
ALU_control = 6'b001001;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

else if (is_slt)
begin
ALU_control = 6'b001010;
temp_2 = rd_out_2;
temp_0 = rd_out_1;
temp_1 = result;
end

if (is_addi)
begin
ALU_control = 6'b001011;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}}, immediate} ;  /// imm to add is stored in temp_2;
temp_1 = result;
end


else if (is_slti)
begin
ALU_control = 6'b001100;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
temp_1 = result;
end



else if (is_sltiu)   // wr_enable 1 krna hai
begin
ALU_control = 6'b001101;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
temp_1 = result;
end


else if(is_andi)
begin
ALU_control = 6'b001110;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
temp_1 = result;
end


else if(is_ori)
begin
ALU_control = 6'b001111;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
temp_1 = result;
end



else if(is_slli)
begin
ALU_control = 6'b010000;
temp_0 = rd_out_1;
temp_2 = {{27'b0} , immediate[4:0]};
temp_1 = result;
end


else if (is_srli)
begin
ALU_control = 6'b010001;
temp_0 = rd_out_1;
temp_2 = {{27'b0} , immediate[4:0]};
temp_1 = result;
end


else if(is_srai)
begin
ALU_control = 6'b010010;
temp_0 = rd_out_1;
temp_2 = {{27'b0} , immediate[4:0]};
temp_1 = result;
end


else if(is_lbu)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};   
complete_address  = result;   // temp_2 acts as offset
temp_1 = {{24'b0},byte_0};
end



else if(is_lb)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
complete_address = result;
temp_1 ={{24{byte_0[7]}},byte_0};
end



else if(is_lh)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate}; 
complete_address = result;
temp_1 ={{16{byte_1[7]}} ,byte_1,byte_0};
end





else if(is_lw)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
complete_address = result;
temp_1 = data_out;
end





else if(is_lhu)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
complete_address = result;
temp_1= {{16{1'b0}} , byte_1 , byte_0};
end


if (is_sb)
begin
ALU_control = 6'b000001;
temp_2 = {{20{instruction[31]}} , offset_immediate};
temp_0 = rd_out_1;
complete_address = result;
temp_1 = {{24'b0} , rd_out_2[7:0]};
end


else if(is_sh)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{instruction[31]}} , offset_immediate};
complete_address = result;
temp_1 = {{16'b0} , rd_out_2[15:0]};
end


else if (is_sw)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{instruction[31]}} , offset_immediate};
complete_address = result;
temp_1 = rd_out_2[31:0];
end


else if(is_beq)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if (rd_out_1 == rd_out_2)
begin
temp_2 = {{20{raw_immediate[11]}}, raw_immediate}<<1;
PC_final = result;
end
end


else if(is_bne)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if(rd_out_1 != rd_out_2)
begin
temp_2 = {{20{raw_immediate[11]}}, raw_immediate}<<1;
PC_final = result;
end
end


else if(is_blt)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if ($signed(rd_out_1) < $signed(rd_out_2))
begin
temp_2 = {{20{raw_immediate[11]}}, raw_immediate}<<1;
PC_final = result;
end
end

else if(is_bge)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if ($signed(rd_out_1) >= $signed(rd_out_2))
begin
temp_2 = {{20{raw_immediate[11]}} , raw_immediate}<<1;
PC_final = result;
end
end

else if(is_bltu)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if (rd_out_1 < rd_out_2)
begin
temp_2 = {{20{raw_immediate[11]}}, raw_immediate}<<1;
PC_final = result ;
end
end


else if(is_bgeu)
begin
ALU_control = 6'b000001; 
temp_0 = PC_curr;
if (rd_out_1 >= rd_out_2)
begin
temp_2 = {{20{raw_immediate[11]}} , raw_immediate}<<1;
PC_final = result;
end
end


else if (is_jal)
begin
ALU_control = 6'b000001;
temp_0 = PC_curr;
temp_2 = {{12{immediate_jump[19]}}  , immediate_jump}<<1;
PC_final = result;
temp_1 = PC_curr + 4;
end


else if(is_jalr)
begin
ALU_control = 6'b000001;
temp_0 = rd_out_1;
temp_2 = {{20{immediate[11]}} , immediate};
PC_final = {result[31:1] , 1'b0};
end


else if(is_lui)
begin
ALU_control = 6'b000001;
temp_1 = raw_immediate_load_upper << 12;
end


else if(is_auipc)
begin
ALU_control = 6'b000001;
temp_0 = PC_curr;
temp_2 = raw_immediate_load_upper << 12;
temp_1 = result;
end
end










assign neg_B =  is_lbu || is_lb || is_lh || is_lw || is_lhu || is_sb || is_sh || is_sw || is_beq || is_bne || is_blt || is_bge || is_bltu || is_bgeu || is_jal || is_jalr||is_auipc;




assign  wr_enable_register = (destination_register != 5'b0) && (is_add || is_sub || is_and || is_or || is_xor || is_sll || is_slt || is_sltu || is_srl || is_sra || is_addi || is_andi || is_ori || is_xori || is_slli || is_srli || is_srai || is_slti || is_sltiu ||
is_lb || is_lh || is_lw || is_lbu || is_lhu||is_lui||is_auipc||is_jal) ;


assign wr_enable_data = (is_sb || is_sh || is_sw );


assign misalligned_access = (((is_lw || is_sw) && (complete_address[1:0] != 2'b00)) || ((is_lh || is_lhu || is_sh) && (complete_address[0] != 1'b0)));




assign processed_data = temp_1;
assign PC_done = PC_final;
assign overall_address = complete_address;

endmodule
  
  
