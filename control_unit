module register_set(rd_out_1 , rd_out_2 , clk , rst , register_1 , register_2 , destination_register ,incoming_data, wr_en_register);
input[4:0]destination_register;
input [4:0]register_1;
input [4:0]register_2;
input clk;
input rst;
output [31:0]rd_out_1;
output [31:0]rd_out_2;
input [31:0]incoming_data;
input wr_en_register;


reg [31:0]memory[31:0];


reg [5:0]i;

always@(negedge clk or posedge rst)
begin
if(rst)
begin
for(i=0 ; i<32 ; i=i+1)
begin
memory[i]<=32'b0;
end
end
else if(!rst)
begin
if(wr_en_register && destination_register != 5'b0)
begin
memory[destination_register]<=incoming_data;
end
end
end

assign rd_out_1 = memory[register_1];
assign rd_out_2 = memory[register_2];

endmodule
