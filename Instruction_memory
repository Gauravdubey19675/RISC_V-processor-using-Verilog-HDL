module Instruction_memory(instruction_out , PC_curr);
input [31:0]PC_curr;
output [31:0]instruction_out;

reg [7:0]inst_mem[0:1023];

initial 
begin
// Initialize instruction memory
{inst_mem[3],   inst_mem[2],   inst_mem[1],   inst_mem[0]}    = 32'h00100093;  // addi x1, x0, 1   (x1 = 1)
{inst_mem[7],   inst_mem[6],   inst_mem[5],   inst_mem[4]}    = 32'h00208113;      // addi x2, x1, 2   (x2 = 1+2=3)
{inst_mem[11],  inst_mem[10],  inst_mem[9],   inst_mem[8]}    = 32'h00208233;    // add  x4, x1, x2  (x4 = 1+3=4)
{inst_mem[15],  inst_mem[14],  inst_mem[13],  inst_mem[12]}   = 32'h00402223;       // sw   x4, 4(x0)   (Mem[4] = 4)

// Load from address 4 into x5
{inst_mem[19],  inst_mem[18],  inst_mem[17],  inst_mem[16]}   = 32'h00402283;      // lw   x5, 4(x0)   (x5 = Mem[4] = 4)
{inst_mem[23],  inst_mem[22],  inst_mem[21],  inst_mem[20]}   = 32'h00528463;  // beq  x5, x5, 8   (PC += 8, always taken)
{inst_mem[27],  inst_mem[26],  inst_mem[25],  inst_mem[24]}   = 32'h00000013;    // nop (addi x0, x0, 0) - Skipped
{inst_mem[31],  inst_mem[30],  inst_mem[29],  inst_mem[28]}   = 32'h00600313;  // addi x6, x0, 6   (x6 = 6)
{inst_mem[35],  inst_mem[34],  inst_mem[33],  inst_mem[32]}   = 32'h406303b3;   // sub  x7, x6, x6  (x7 = 6-6 = 0)
{inst_mem[39],  inst_mem[38],  inst_mem[37],  inst_mem[36]}   = 32'h0073a023;  // sw   x7, 0(x7)   (Mem[0] = 0)
{inst_mem[43],  inst_mem[42],  inst_mem[41],  inst_mem[40]}   = 32'h00002403;    // lw   x8, 0(x0)   (x8 = Mem[0] = 0)

{inst_mem[47],  inst_mem[46],  inst_mem[45],  inst_mem[44]}   = 32'h00800463;  // beq  x0, x8, 8   (Branch if 0==0, taken)
{inst_mem[51],  inst_mem[50],  inst_mem[49],  inst_mem[48]}   = 32'h00100093;     // addi x1, x0, 1   (x1 = 1) - Skipped
{inst_mem[55],  inst_mem[54],  inst_mem[53],  inst_mem[52]}   = 32'h00200113;   // addi x2, x0, 2   (x2 = 2) - Executed

// FUNCTION CALL (JAL)
// Call function at address 0x50 (80 bytes from start, 20 instructions)
{inst_mem[59],  inst_mem[58],  inst_mem[57],  inst_mem[56]}   = 32'h014000EF;    // jal  x1, 0x50    (ra = PC+4 = 0x3C+4 = 0x40)

// INSTRUCTIONS AFTER JAL (Return Address)
{inst_mem[63],  inst_mem[62],  inst_mem[61],  inst_mem[60]}   = 32'h00300193;  // addi x3, x0, 3   (x3 = 3) - Executed after return
{inst_mem[67],  inst_mem[66],  inst_mem[65],  inst_mem[64]}   = 32'h00400213;     // addi x4, x0, 4   (x4 = 4)
{inst_mem[71],  inst_mem[70],  inst_mem[69],  inst_mem[68]}   = 32'h00500293;  // addi x5, x0, 5   (x5 = 5)
{inst_mem[75],  inst_mem[74],  inst_mem[73],  inst_mem[72]}   = 32'h00600313;    // addi x6, x0, 6   (x6 = 6)

// FUNCTION CODE (Jump Target) 
// Address 0x50 (80): Function starts here
{inst_mem[79],  inst_mem[78],  inst_mem[77],  inst_mem[76]}   = 32'h00120213;  // addi x4, x4, 1   (x4 = x4 + 1) - Function body
{inst_mem[83],  inst_mem[82],  inst_mem[81],  inst_mem[80]}   = 32'h00220333;     // add  x6, x4, x2  (x6 = x4 + x2)
{inst_mem[87],  inst_mem[86],  inst_mem[85],  inst_mem[84]}   = 32'h00602023;  // sw   x6, 0(x0)   (Mem[0] = x6)

//  FUNCTION RETURN (JALR)
// Return to caller using the address saved in ra (x1)
{inst_mem[91],  inst_mem[90],  inst_mem[89],  inst_mem[88]}   = 32'h00008067;  // jalr x0, 0(x1)   (PC = ra + 0 = 0x40)

// CONTINUATION AFTER RETURN 
// Address 0x40 (64): Execution continues here after return
{inst_mem[95],  inst_mem[94],  inst_mem[93],  inst_mem[92]}   = 32'h00700413;  // addi x8, x0, 7   (x8 = 7)
{inst_mem[99],  inst_mem[98],  inst_mem[97],  inst_mem[96]}   = 32'h00802423;     // sw   x8, 8(x0)   (Mem[8] = 7)
{inst_mem[103], inst_mem[102], inst_mem[101], inst_mem[100]}  = 32'h00000013;      // nop
{inst_mem[107], inst_mem[106], inst_mem[105], inst_mem[104]}  = 32'h00000013;  // nop

end

assign instruction_out = {inst_mem[PC_curr + 3] , inst_mem[PC_curr +  2] , inst_mem[PC_curr + 1] , inst_mem[PC_curr]};


endmodule
